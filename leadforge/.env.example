# ============================================
# LeadForge AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Hermes Agent
HERMES_API_URL=http://hermes:8642
HERMES_API_KEY=your-hermes-api-key

# Email Provider (e.g., SendGrid, Resend, Postmark)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=outreach@leadforge.ai
EMAIL_FROM_NAME=LeadForge AI

# Vercel (for website deployment)
VERCEL_TOKEN=your-vercel-token

# Business Data API (Google Places, Overpass, etc.)
BUSINESS_DATA_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=your-google-places-key

# Redis
REDIS_URL=redis://redis:6379

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Security
JWT_SECRET=your-jwt-secret-change-me